# App port inside the container (external is mapped to 3002 in docker-compose)
PORT=3002

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_TIMEOUT=10000

# App Configuration
NEXT_PUBLIC_APP_NAME="Luisardito Shop"
NEXT_PUBLIC_APP_VERSION=2.0.0

# Development Configuration
NODE_ENV=development
NEXT_PUBLIC_ENABLE_DEBUG=true

# OAuth con Kick
NEXT_PUBLIC_KICK_CLIENT_ID=01K34A5CYMAT6HZ8KZ3HBA5XFM
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3001/auth/callback
NEXT_PUBLIC_KICK_OAUTH_URL=https://kick.com/oauth/authorize
NEXT_PUBLIC_KICK_TOKEN_URL=https://kick.com/oauth/token
NEXT_PUBLIC_KICK_USER_URL=https://api.kick.com/public/v1/users
NEXT_PUBLIC_KICK_SCOPE=user:read

# Cloudinary (for unsigned uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=naferj
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=luisardito_shop_preset
