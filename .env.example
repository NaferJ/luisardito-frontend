# Frontend environment variables
# Copy to .env for local dev. On Vercel, set these in Project Settings > Environment Variables.
# All vars are NEXT_PUBLIC_ because they are inlined into the client bundle at build time.

# --- API ---
# Base URL of the backend API (used in lib/api.ts, lib/public-api.ts, proxy.ts, lib/kick-auth.ts)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Request timeout for API calls in milliseconds (optional, carried over from legacy frontend)
NEXT_PUBLIC_API_TIMEOUT=10000

# --- App metadata (optional) ---
# Display name of the app
NEXT_PUBLIC_APP_NAME=Luisardito

# App version string (optional, informational)
NEXT_PUBLIC_APP_VERSION=2.0.0

# Enable debug logging in the browser (optional, set to "false" in production)
NEXT_PUBLIC_ENABLE_DEBUG=false

# --- Kick OAuth (client-side metadata) ---
# NOTE: The actual Kick OAuth flow runs on the backend. The frontend only redirects
# to `${NEXT_PUBLIC_API_URL}/api/auth/kick`. These vars are carried over from the
# legacy frontend and are not actively read by the current code, but are documented
# here for completeness and potential future use.

# Kick OAuth client ID
NEXT_PUBLIC_KICK_CLIENT_ID=your_kick_client_id

# Kick OAuth redirect URI (must match the URI registered on the Kick developer portal)
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/callback

# Kick OAuth authorization endpoint
NEXT_PUBLIC_KICK_OAUTH_URL=https://id.kick.com/oauth/authorize

# Kick OAuth token endpoint
NEXT_PUBLIC_KICK_TOKEN_URL=https://id.kick.com/oauth/token

# Kick user profile API endpoint
NEXT_PUBLIC_KICK_USER_URL=https://api.kick.com/public/v1/users

# Kick OAuth scopes (space-separated)
NEXT_PUBLIC_KICK_SCOPE=user:read events:subscribe kicks:read

# --- Cloudinary (client-side unsigned uploads) ---
# Cloudinary cloud name (used in components/admin/image-upload.tsx)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary unsigned upload preset (used in components/admin/image-upload.tsx)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# --- Vercel built-in (do NOT set manually) ---
# NEXT_PUBLIC_VERCEL_URL is automatically provided by Vercel at deployment time.
# It is read in lib/cookies.ts to detect localhost vs production. No action needed.
